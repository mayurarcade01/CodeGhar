<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>@ViewData["Title"] · CodeGhar</title>
  <link rel="icon" href="~/favicon.svg"/>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
  <style>
    /* Topbar & Header Enhancements */
    .topbar {
      height: 64px;
      background: #ffffff;
      border-bottom: 1px solid var(--line);
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 32px;
      gap: 20px;
    }
    .topbar-left {
      display: flex;
      align-items: center;
      gap: 9px;
      font-size: 13.5px;
      min-width: 190px;
    }
    .crumb-brand {
      color: var(--muted);
      text-decoration: none;
      display: flex;
      align-items: center;
      gap: 6px;
      font-weight: 600;
      transition: color 0.15s;
    }
    .crumb-brand:hover {
      color: var(--blue);
    }
    .crumb-sep {
      color: #94a3b8;
      font-weight: 400;
    }
    .crumb-page {
      color: var(--ink);
      font-weight: 750;
    }

    .topbar-center {
      flex: 1;
      max-width: 520px;
    }
    .topbar-search {
      display: flex;
      align-items: center;
      gap: 9px;
      background: #f4f6f9;
      border: 1px solid #d9e1ec;
      border-radius: 7px;
      padding: 6px 12px;
      transition: all 0.2s ease;
    }
    .topbar-search:focus-within {
      background: #ffffff;
      border-color: var(--blue);
      box-shadow: 0 0 0 3px rgba(47, 111, 237, 0.12);
    }
    .topbar-search svg {
      color: var(--muted);
      flex-shrink: 0;
    }
    .topbar-search input {
      border: none !important;
      background: transparent !important;
      outline: none !important;
      padding: 0 !important;
      margin: 0 !important;
      font-size: 13px !important;
      color: var(--ink) !important;
      width: 100% !important;
      box-shadow: none !important;
    }
    .search-hint {
      font-size: 10.5px;
      font-weight: 700;
      color: #94a3b8;
      background: #e2e8f0;
      padding: 2px 7px;
      border-radius: 4px;
      flex-shrink: 0;
      letter-spacing: 0.02em;
      user-select: none;
    }

    .topbar-right {
      display: flex;
      align-items: center;
      gap: 16px;
      flex-shrink: 0;
    }
    .status-indicator-pill {
      display: flex;
      align-items: center;
      gap: 7px;
      background: #ecfdf5;
      border: 1px solid #a7f3d0;
      padding: 5px 12px;
      border-radius: 999px;
      font-size: 11.5px;
      font-weight: 650;
      color: #065f46;
      white-space: nowrap;
    }
    .status-dot-pulse {
      width: 7px;
      height: 7px;
      background: #10b981;
      border-radius: 50%;
      box-shadow: 0 0 0 2px rgba(16, 185, 129, 0.25);
    }

    .topbar-user-pill {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 4px 12px 4px 5px;
      border-radius: 999px;
      background: #f8fafc;
      border: 1px solid #e2e8f0;
    }
    .avatar-circle {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background: linear-gradient(135deg, #083863, #0284c7);
      color: #ffffff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 12px;
      font-weight: 800;
      letter-spacing: 0.04em;
    }
    .user-pill-text {
      display: flex;
      flex-direction: column;
      line-height: 1.2;
    }
    .user-pill-text strong {
      font-size: 12.5px;
      color: var(--ink);
      font-weight: 750;
    }
    .user-pill-text small {
      font-size: 10px;
      color: var(--muted);
      font-weight: 600;
    }

    /* Sidebar Navigation Improvements */
    .nav-link {
      display: flex;
      align-items: center;
      gap: 11px;
      font-size: 13.5px;
      font-weight: 600;
    }
    .nav-link svg {
      flex-shrink: 0;
    }
  </style>
</head>
<body>
  <div class="app-shell">
    
    <!-- Left Navigation Sidebar -->
    <aside class="sidebar">
      <a class="brand" asp-controller="Files" asp-action="Index">
        <img src="~/images/codeghar-logo.svg" alt="CodeGhar"/>
        <span>CodeGhar</span>
      </a>

      <p class="nav-label">WORKSPACE</p>

      <!-- Dashboard Link -->
      <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Files" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" && string.IsNullOrEmpty(Context.Request.Query["search"]) ? "active" : "")" asp-controller="Files" asp-action="Index">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
          <rect x="3" y="3" width="7" height="7"></rect>
          <rect x="14" y="3" width="7" height="7"></rect>
          <rect x="14" y="14" width="7" height="7"></rect>
          <rect x="3" y="14" width="7" height="7"></rect>
        </svg>
        <span>Dashboard</span>
      </a>

      <p class="nav-label" style="margin-top: 24px;">RESOURCES</p>
      <a class="nav-link" href="https://learn.microsoft.com/aspnet/core" target="_blank">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
          <circle cx="12" cy="12" r="10"></circle>
          <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
          <line x1="12" y1="17" x2="12.01" y2="17"></line>
        </svg>
        <span>Documentation ↗</span>
      </a>

      <p class="sidebar-note">
        Your code.<br/>
        Every version.<br/>
        Always recoverable.
      </p>

      <div class="sidebar-footer">
        ENTERPRISE MODE<br/>
        <span>MySQL · EF Core</span>
      </div>
    </aside>

    <!-- Main Content Area -->
    <main class="main-content">
      
      <!-- Topbar Header (Enriched & Functional) -->
      <header class="topbar">
        
        <!-- Left: Breadcrumb Navigation -->
        <div class="topbar-left">
          <a asp-controller="Files" asp-action="Index" class="crumb-brand">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
              <polyline points="9 22 9 12 15 12 15 22"></polyline>
            </svg>
            <span>CodeGhar</span>
          </a>
          <span class="crumb-sep">/</span>
          <span class="crumb-page">@(ViewData["Title"] ?? "Dashboard")</span>
        </div>

        <!-- Center: Quick Repository Search Bar -->
        <div class="topbar-center">
          <form class="topbar-search" method="get" asp-controller="Files" asp-action="Index">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input type="text" name="search" placeholder="Search repository files, code, extensions..." value="@Context.Request.Query["search"]" />
            <span class="search-hint">↵ Search</span>
          </form>
        </div>

        <!-- Right: Status Pill & User Metadata -->
        <div class="topbar-right">
          @if (!string.IsNullOrEmpty(Context.Session.GetString("LastAction")))
          {
            <div class="status-indicator-pill" style="background:#eff6ff;border-color:#bfdbfe;color:#1e40af;" title="State Management Session Tracker">
              <span style="display:inline-block;width:7px;height:7px;background:#3b82f6;border-radius:50%;"></span>
              <span>@Context.Session.GetString("LastAction")</span>
            </div>
          }
          <div class="status-indicator-pill">
            <span class="status-dot-pulse"></span>
            <span>MySQL · EF Core Active</span>
          </div>
          <div class="topbar-user-pill">
            <div class="avatar-circle">GM</div>
            <div class="user-pill-text">
              <strong>Girase Mayur</strong>
              <small>AMTICS · UTU</small>
            </div>
          </div>
        </div>

      </header>

      <!-- Page Body Content -->
      <div class="page-wrap">
        @RenderBody()
      </div>

    </main>
  </div>

  <script src="~/js/site.js" asp-append-version="true"></script>
  @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
