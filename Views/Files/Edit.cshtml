@model CodeGhar.Models.CodeFile
@{ViewData["Title"]=Model.Name; var v=Model.Versions.OrderByDescending(x=>x.Number).First();}
<div class="editor-head"><div><a class="back" asp-action="Index">← Workspace</a><h1>@Model.Name <a class="version" asp-action="History" asp-route-id="@Model.Id">@v.Label</a></h1><p class="muted">Last saved @Model.UpdatedUtc.ToLocalTime().ToString("MMM d, yyyy · HH:mm")</p></div><div class="row-actions top-actions"><a class="btn ghost" asp-action="Download" asp-route-id="@Model.Id">↓ Download</a><a class="btn ghost" asp-action="History" asp-route-id="@Model.Id">History</a><button class="btn primary" type="submit" form="save-form">Save changes</button></div></div>
@if(TempData["Notice"] is not null){<div class="notice success">@TempData["Notice"]</div>} @if(TempData["Error"] is not null){<div class="notice error">@TempData["Error"]</div>}
<form method="post" asp-action="Save" id="save-form" class="editor-form"><input type="hidden" name="id" value="@Model.Id" /><div class="editor-meta"><span class="dot"></span><span>Editing current content</span><input name="message" placeholder="What changed? (optional)" /></div><textarea class="code-editor" name="content" spellcheck="false">@v.Content</textarea><div class="editor-footer"><span class="muted">Plain text · max 2 MB</span><button class="btn primary">Save version</button></div></form>
<details class="rename"><summary>Rename file</summary><form method="post" asp-action="Rename"><input type="hidden" name="id" value="@Model.Id"/><input name="name" value="@Model.Name"/><button class="btn ghost">Rename</button></form></details><form method="post" asp-action="Delete" class="danger-form" onsubmit="return confirm('Move this file out of the workspace? Its history will be preserved in storage.')"><input type="hidden" name="id" value="@Model.Id"/><button class="link-danger">Delete file</button></form>
