@model CodeGhar.Models.CodeFile
@using CodeGhar.Models
@{ViewData["Title"]="History · "+Model.Name; CodeVersion target=ViewBag.Target; CodeVersion? baseV=ViewBag.Base; IReadOnlyList<DiffLine> lines=ViewBag.Diff;}
<div class="editor-head"><div><a class="back" asp-action="Edit" asp-route-id="@Model.Id">← @Model.Name</a><h1>Version history</h1><p class="muted">@Model.Versions.Count immutable snapshots · target @target.Label @(baseV is null?"(initial version)":"compared with "+baseV.Label)</p></div></div>
<div class="history-layout"><aside class="timeline">@foreach(var v in Model.Versions.OrderByDescending(x=>x.Number)){<div class="history-item @(v.Number==target.Number?"selected":"")"><a asp-action="History" asp-route-id="@Model.Id" asp-route-compare="@v.Number"><strong>@v.Label</strong><span>@v.CreatedUtc.ToLocalTime().ToString("MMM d, HH:mm")</span><small>@(v.Message ?? "No message")</small></a><form method="post" asp-action="Restore" onsubmit="return confirm('Restore @v.Label? This creates a new major version and preserves history.')"><input type="hidden" name="id" value="@Model.Id"/><input type="hidden" name="number" value="@v.Number"/><button>Restore</button></form></div>}</aside><section class="diff-card"><div class="diff-toolbar"><span>@(baseV?.Label ?? "—") → <b>@target.Label</b></span><span class="legend"><i class="add">+</i> additions <i class="remove">−</i> removals</span></div><div class="diff">@foreach(var line in lines){<div class="diff-line @line.Kind"><span class="line-no">@(line.OldLine==0?"":line.OldLine.ToString())</span><span class="line-no">@(line.NewLine==0?"":line.NewLine.ToString())</span><span class="mark">@(line.Kind=="added"?"+":line.Kind=="removed"?"−":" ")</span><code>@line.Text</code></div>}</div></section></div>
