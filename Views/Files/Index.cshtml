@model List<CodeGhar.Models.CodeFile>
@{ ViewData["Title"]="Workspace"; }
<div class="hero"><div><p class="eyebrow">LOCAL WORKSPACE</p><h1>Your code, every version.</h1><p class="muted">A calm, dependable home for the files you are still shaping.</p></div><div class="hero-actions"><button class="btn ghost" onclick="document.getElementById('upload').showModal()">↑ Upload files</button><button class="btn primary" onclick="document.getElementById('create').showModal()">+ New file</button></div></div>
<div class="toolbar"><form method="get"><input name="search" value="@Context.Request.Query["search"]" placeholder="Search by filename..." aria-label="Search files" /><button class="btn ghost">Search</button></form><span class="count">@Model.Count @(Model.Count == 1 ? "file" : "files") · local storage</span></div>
@if(TempData["Notice"] is not null){<div class="notice success">@TempData["Notice"]</div>} @if(TempData["Error"] is not null){<div class="notice error">@TempData["Error"]</div>}
<section class="file-table"><div class="table-head"><span>FILE</span><span>UPDATED</span><span>VERSION</span><span>ACTIONS</span></div>@foreach(var f in Model){var current=f.Versions.OrderByDescending(x=>x.Number).FirstOrDefault();<div class="file-row"><div class="file-name"><span class="file-icon">@f.Extension.TrimStart('.').ToUpperInvariant().Substring(0,Math.Min(3, f.Extension.TrimStart('.').Length))</span><div><a asp-action="Edit" asp-route-id="@f.Id">@f.Name</a><small>@f.Extension · @f.Versions.Count version@(f.Versions.Count==1?"":"s")</small></div></div><span class="muted">@f.UpdatedUtc.ToLocalTime().ToString("MMM d, yyyy · HH:mm")</span><a class="version" asp-action="History" asp-route-id="@f.Id">@(current?.Label ?? "v1")</a><div class="row-actions"><a class="btn small-btn" asp-action="Edit" asp-route-id="@f.Id">Edit</a><a class="btn small-btn" asp-action="Download" asp-route-id="@f.Id">Download</a></div></div>} @if(Model.Count==0){<div class="empty"><img src="~/images/codeghar-logo.svg" alt="" /><h2>No files yet</h2><p>Create your first text or source file to start building history.</p></div>}</section>
<dialog id="upload"><form method="post" asp-action="Upload" enctype="multipart/form-data"><div class="dialog-head"><h2>Upload from computer</h2><button type="button" onclick="this.closest('dialog').close()">×</button></div><label class="drop-zone" for="file-input"><span class="upload-symbol">↑</span><strong>Choose a source file</strong><small id="file-name">TXT, MD, CS, JS, JSON and more · up to 2 MB</small><input id="file-input" type="file" name="file" required /></label><label>Change message<input name="message" placeholder="Uploaded from local storage" /></label><div class="dialog-actions"><button type="button" class="btn ghost" onclick="this.closest('dialog').close()">Cancel</button><button class="btn primary">Upload file</button></div></form></dialog>
<dialog id="create"><form method="post" asp-action="Create"><div class="dialog-head"><h2>Create a file</h2><button type="button" onclick="this.closest('dialog').close()">×</button></div><label>Filename<input name="name" required placeholder="Notes.md" /></label><label>Change message<input name="message" placeholder="Initial version" /></label><label>Content<textarea name="content" rows="12" placeholder="# Start here"></textarea></label><div class="dialog-actions"><button type="button" class="btn ghost" onclick="this.closest('dialog').close()">Cancel</button><button class="btn primary">Create file</button></div></form></dialog>
